# ---------------------------------------------------------------------------
# Git LFS: large model artifacts are stored via Git LFS, not in the git history.
# After cloning run:  git lfs pull
# ---------------------------------------------------------------------------
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Notebooks keep their executed outputs on purpose: the outputs are part of the
# experimental evidence stored in this repository. No output-stripping filter is
# configured, so `git add` works without extra tooling.
# ---------------------------------------------------------------------------
